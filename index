<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>SenosAmorim Performance</title>
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;600;700&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --bg-primary: #03060c;
      --bg-secondary: #07101f;
      --blue-main: #526BA9;
      --blue-accent: #2F64FF;
      --white: #FFFFFF;
      --gray-light: #C8D0DE;
      --whatsapp: #20D66B;
    }

    body {
      font-family: 'Montserrat', sans-serif;
      background-color: var(--bg-primary);
      color: var(--white);
      overflow-x: hidden;
    }

    /* ========== HEADER ========== */
    header {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 100;
      padding: 0 48px;
      height: 120px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: linear-gradient(to bottom, rgba(3,6,12,0.90) 0%, transparent 100%);
    }

    .logo {
      display: flex;
      align-items: center;
      height: 100%;
    }

    .logo img {
      height: 300px; /* altere só este valor para mudar o tamanho da logo */
      width: auto;
      object-fit: contain;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 28px;
    }

    nav a {
      font-family: 'Montserrat', sans-serif;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--gray-light);
      text-decoration: none;
      transition: color 0.2s;
    }

    nav a:hover { color: var(--white); }

    .menu-toggle {
      display: none;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 4px;
    }

    .menu-toggle span {
      display: block;
      width: 24px;
      height: 2px;
      background: var(--white);
      border-radius: 2px;
    }

    .mobile-menu {
      display: none;
      position: fixed;
      top: 80px;
      left: 0;
      width: 100%;
      background: rgba(3,6,12,0.97);
      padding: 24px 28px;
      flex-direction: column;
      gap: 20px;
      z-index: 99;
      border-top: 1px solid rgba(47,100,255,0.3);
    }

    .mobile-menu.open { display: flex; }

    .mobile-menu a {
      font-family: 'Montserrat', sans-serif;
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--gray-light);
      text-decoration: none;
      padding: 10px 0;
      border-bottom: 1px solid rgba(255,255,255,0.07);
    }

    .mobile-menu a:last-child { border-bottom: none; }

    .btn-whatsapp-header {
      display: flex;
      align-items: center;
      gap: 8px;
      background: transparent;
      border: 2px solid var(--blue-accent);
      color: var(--white);
      font-family: 'Montserrat', sans-serif;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 10px 20px;
      border-radius: 4px;
      text-decoration: none;
      transition: background 0.2s, color 0.2s;
      cursor: pointer;
      white-space: nowrap;
    }

    .btn-whatsapp-header:hover { background: var(--blue-accent); }
    .btn-whatsapp-header svg { width: 16px; height: 16px; }

    /* ========== HERO ========== */
    .hero {
      position: relative;
      width: 100%;
      min-height: 100vh;
      overflow: hidden;
    }

    .hero-bg {
      background-image: url('capa.png');
      background-size: cover;
      background-position: center top;
      background-repeat: no-repeat;
      position: absolute;
      inset: 0;
      z-index: 0;
    }

    .hero-bg::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        rgba(3,6,12,0.72) 0%,
        rgba(3,6,12,0.35) 55%,
        rgba(3,6,12,0.05) 100%
      );
    }

    .hero::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(to right, var(--blue-accent), var(--blue-main), transparent);
      z-index: 10;
    }

    .hero-content {
      position: relative;
      z-index: 5;
      display: flex;
      align-items: center;
      min-height: 100vh;
      padding: 140px 60px 80px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .hero-text { max-width: 540px; }

    .hero-label {
      display: inline-block;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--blue-accent);
      margin-bottom: 18px;
      border-left: 3px solid var(--blue-accent);
      padding-left: 10px;
    }

    .hero-title {
      font-family: 'Oswald', sans-serif;
      font-size: clamp(42px, 5.5vw, 68px);
      font-weight: 700;
      line-height: 1.05;
      text-transform: uppercase;
      color: var(--white);
      margin-bottom: 10px;
    }

    .hero-title .highlight { color: var(--blue-accent); }

    .hero-title .title-last-line {
      display: block;
      white-space: nowrap;
    }

    .hero-subtitle {
      font-size: 14px;
      font-weight: 500;
      color: var(--gray-light);
      line-height: 1.7;
      margin-top: 18px;
      margin-bottom: 30px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .hero-subtitle .hl { color: var(--blue-accent); font-weight: 600; }

    .hero-benefits {
      display: flex;
      gap: 24px;
      margin-bottom: 36px;
      flex-wrap: wrap;
    }

    .benefit-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }

    .benefit-icon {
      width: 36px;
      height: 36px;
      border: 1.5px solid var(--blue-accent);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .benefit-icon svg { width: 16px; height: 16px; fill: var(--blue-accent); }

    .benefit-text strong {
      display: block;
      font-size: 13px;
      font-weight: 700;
      color: var(--white);
    }

    .benefit-text span {
      font-size: 11px;
      color: var(--gray-light);
    }

    .btn-hero {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: var(--blue-accent);
      color: var(--white);
      font-family: 'Oswald', sans-serif;
      font-size: 17px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      padding: 16px 36px;
      border-radius: 4px;
      text-decoration: none;
      transition: background 0.2s, transform 0.15s;
    }

    .btn-hero:hover { background: #1a50e0; transform: translateY(-2px); }
    .btn-hero svg { width: 20px; height: 20px; }

    .hero-caption {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 14px;
      font-size: 12px;
      color: var(--gray-light);
    }

    .hero-caption svg { width: 14px; height: 14px; fill: var(--blue-main); }

    /* ========== BENEFÍCIOS ========== */
    .beneficios {
      background-color: #030e1e;
      padding: 70px 60px;
      text-align: center;
    }

    .beneficios-label {
      font-family: 'Montserrat', sans-serif;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--blue-accent);
      margin-bottom: 10px;
    }

    .beneficios-title {
      font-family: 'Oswald', sans-serif;
      font-size: clamp(28px, 3.5vw, 42px);
      font-weight: 700;
      text-transform: uppercase;
      color: var(--white);
      margin-bottom: 50px;
    }

    .beneficios-grid {
      display: flex;
      justify-content: center;
      gap: 0;
      flex-wrap: nowrap;
    }

    .beneficio-card {
      flex: 1;
      max-width: 220px;
      padding: 30px 20px;
      border-right: 1px solid rgba(47,100,255,0.2);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      transition: background 0.3s, transform 0.3s;
      border-radius: 8px;
      cursor: default;
    }

    .beneficio-card:hover {
      background: rgba(47,100,255,0.08);
      transform: translateY(-6px);
    }

    .beneficio-card:hover h3 { color: var(--blue-accent); }
    .beneficio-card img { transition: transform 0.3s; }
    .beneficio-card:hover img { transform: scale(1.1); }
    .beneficio-card:last-child { border-right: none; }

    .beneficio-card img {
      width: 64px;
      height: 64px;
      object-fit: contain;
    }

    .beneficio-card h3 {
      font-family: 'Oswald', sans-serif;
      font-size: 15px;
      font-weight: 600;
      text-transform: uppercase;
      color: var(--white);
      line-height: 1.3;
    }

    .beneficio-card p {
      font-size: 12px;
      color: var(--gray-light);
      line-height: 1.6;
    }

    /* ========== SOBRE NÓS ========== */
    .sobre {
      background-color: #03060c;
      padding: 80px 60px;
    }

    .sobre-inner {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      align-items: flex-start;
      gap: 60px;
    }

    .sobre-foto {
      flex-shrink: 0;
      width: 420px;
      border: 1.5px solid var(--blue-accent);
      border-radius: 6px;
      overflow: hidden;
    }

    .sobre-foto img {
      width: 100%;
      height: auto;
      object-fit: cover;
      display: block;
    }

    .sobre-texto { flex: 1; }

    .sobre-label {
      font-family: 'Montserrat', sans-serif;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--blue-accent);
      margin-bottom: 10px;
    }

    .sobre-title {
      font-family: 'Oswald', sans-serif;
      font-size: clamp(26px, 3vw, 38px);
      font-weight: 700;
      text-transform: uppercase;
      color: var(--white);
      margin-bottom: 24px;
      line-height: 1.1;
    }

    .sobre-desc {
      font-size: 15px;
      color: var(--gray-light);
      line-height: 1.8;
      margin-bottom: 24px;
    }

    .sobre-destaque {
      font-size: 15px;
      font-weight: 700;
      color: var(--white);
      line-height: 1.8;
      margin-bottom: 36px;
    }

    .btn-sobre {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: transparent;
      border: 2px solid var(--blue-accent);
      color: var(--white);
      font-family: 'Montserrat', sans-serif;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 10px 20px;
      border-radius: 4px;
      text-decoration: none;
      transition: background 0.2s;
      cursor: pointer;
      white-space: nowrap;
    }

    .btn-sobre:hover { background: var(--blue-accent); }
    .btn-sobre svg { width: 16px; height: 16px; }

    /* ========== METODOLOGIA ========== */
    .metodologia {
      background-color: #07101f;
      padding: 80px 60px;
    }

    .metodologia-inner {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 50px;
      text-align: center;
    }

    .metodologia-label {
      font-family: 'Montserrat', sans-serif;
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--blue-accent);
    }

    .metodologia-title {
      font-family: 'Oswald', sans-serif;
      font-size: clamp(50px, 3.5vw, 42px);
      font-weight: 700;
      text-transform: uppercase;
      color: var(--white);
    }

    .metodologia-body {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 60px;
    }

    .metodologia-etapas {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .etapa {
      display: flex;
      align-items: flex-start;
      gap: 20px;
    }

    .etapa-num {
      flex-shrink: 0;
      width: 65px;
      height: 65px;
      border: 2px solid var(--blue-accent);
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Oswald', sans-serif;
      font-size: 30px;
      font-weight: 700;
      color: var(--blue-accent);
    }

    .etapa-texto h3 {
      font-family: 'Oswald', sans-serif;
      font-size: 18px;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--white);
      margin-bottom: 6px;
    }

    .etapa-texto p {
      font-size: 13px;
      color: var(--gray-light);
      line-height: 1.7;
    }

    .metodologia-foto {
      flex-shrink: 0;
      width: 420px;
      border: 1.5px solid var(--blue-accent);
      border-radius: 6px;
      overflow: hidden;
    }

    .metodologia-foto img {
      width: 100%;
      height: auto;
      display: block;
      object-fit: cover;
    }

    /* ========== CTA FINAL ========== */
    .cta {
      position: relative;
      padding: 70px 60px;
      text-align: center;
      overflow: hidden;
    }

    .cta-bg {
      background-image: url('fundo.png');
      background-size: cover;
      background-position: center;
      position: absolute;
      inset: 0;
      z-index: 0;
    }

    .cta-content {
      position: relative;
      z-index: 1;
    }

    .cta-title {
      font-family: 'Oswald', sans-serif;
      font-size: clamp(28px, 3.5vw, 44px);
      font-weight: 700;
      text-transform: uppercase;
      color: var(--white);
      margin-bottom: 10px;
    }

    .cta-subtitle {
      font-size: 15px;
      font-weight: 500;
      color: var(--white);
      margin-bottom: 32px;
    }

    .btn-cta {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: var(--whatsapp);
      color: var(--white);
      font-family: 'Oswald', sans-serif;
      font-size: 18px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      padding: 18px 48px;
      border-radius: 6px;
      text-decoration: none;
      transition: background 0.2s, transform 0.15s;
    }

    .btn-cta:hover { background: #17b85a; transform: translateY(-2px); }
    .btn-cta svg { width: 22px; height: 22px; }

    .cta-caption {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 16px;
      font-size: 13px;
      color: rgba(255,255,255,0.85);
    }

    .cta-caption svg { width: 14px; height: 14px; fill: rgba(255,255,255,0.85); }

    /* ========== RODAPÉ ========== */
    .rodape {
      background-color: #07101f;
      padding: 32px 60px 0;
      border-top: 1px solid rgba(47,100,255,0.2);
    }

    .rodape-inner {
      max-width: 1100px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 220px 1fr 1fr;
      gap: 48px;
      padding-bottom: 24px;
      align-items: start;
    }

    .rodape-logo {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .rodape-logo img {
      height: 44px;
      width: auto;
      object-fit: contain;
      display: block;
    }

    .rodape-desc {
      font-size: 13px;
      color: var(--gray-light);
      line-height: 1.7;
    }

    .rodape-col h4 {
      font-family: 'Oswald', sans-serif;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--white);
      margin-bottom: 18px;
    }

    .rodape-col ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .rodape-col ul li a {
      font-size: 13px;
      color: var(--gray-light);
      text-decoration: none;
      transition: color 0.2s;
    }

    .rodape-col ul li a:hover { color: var(--white); }

    .rodape-contato {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .contato-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 13px;
      color: var(--gray-light);
      text-decoration: none;
      transition: color 0.2s;
    }

    .contato-item:hover { color: var(--white); }

    .contato-item svg {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
      margin-top: 1px;
    }

    .rodape-copy {
      border-top: 1px solid rgba(255,255,255,0.07);
      padding: 16px 0;
      text-align: center;
      font-size: 12px;
      color: var(--gray-light);
    }

    /* ========== RESPONSIVO TABLET ========== */
    @media (max-width: 900px) {
      header { padding: 0 28px; }
      nav { gap: 18px; }
      nav a { font-size: 11px; }
      .hero-content { padding: 110px 36px 60px; }
      .hero-title { font-size: 48px; }

      .beneficios { padding: 60px 28px; }
      .beneficios-grid { flex-wrap: wrap; gap: 0; }
      .beneficio-card {
        flex: 0 0 50%;
        max-width: 50%;
        border-right: none;
        border-bottom: 1px solid rgba(47,100,255,0.2);
        padding: 24px 16px;
      }
      .beneficio-card:nth-child(odd) { border-right: 1px solid rgba(47,100,255,0.2); }
      .beneficio-card:last-child { border-bottom: none; border-right: none; }

      .sobre { padding: 60px 28px; }
      .sobre-inner { flex-direction: column; gap: 28px; }
      .sobre-foto { width: 75%; margin: 0 auto; }

      .metodologia { padding: 60px 28px; }
      .metodologia-body { flex-direction: column; gap: 36px; }
      .metodologia-foto { width: 75%; margin: 0 auto; }

      .rodape { padding: 32px 28px 0; }
      .rodape-inner { grid-template-columns: 1fr 1fr; gap: 32px; }
    }

    /* ========== RESPONSIVO MOBILE ========== */
    @media (max-width: 640px) {
      header { padding: 0 20px; }
      nav { display: none; }
      .btn-whatsapp-header { display: none; }
      .menu-toggle { display: flex; }

      .hero { min-height: 100svh; }

      .hero-bg {
        background-image: url('capa_mobile.png');
        background-position: center top;
        background-size: cover;
      }

      .hero-bg::after {
        background: linear-gradient(
          to right,
          rgba(3,6,12,0.88) 0%,
          rgba(3,6,12,0.60) 50%,
          rgba(3,6,12,0.05) 100%
        );
      }

      .hero-content {
        padding: 20vh 0 48px;
        align-items: flex-start;
      }

      .hero-text {
        max-width: 58%;
        padding-left: 20px;
      }

      .hero-label { font-size: 9px; letter-spacing: 1.5px; }

      .hero-title {
        font-size: clamp(22px, 6.5vw, 34px);
        line-height: 1.08;
      }

      .hero-subtitle { font-size: 11px; }
      .hero-benefits { flex-direction: column; gap: 12px; }
      .benefit-text strong { font-size: 11px; }
      .benefit-text span { font-size: 10px; }

      .btn-hero {
        font-size: 13px;
        padding: 13px 16px;
        gap: 7px;
      }

      .hero-caption { font-size: 10px; }

      .beneficios { padding: 48px 20px; }
      .beneficios-title { font-size: 24px; margin-bottom: 36px; }
      .beneficio-card { flex: 0 0 50%; max-width: 50%; }

      .sobre { padding: 48px 20px; }
      .sobre-inner { flex-direction: column; gap: 28px; }
      .sobre-texto { order: 1; }
      .sobre-foto { order: 2; width: 75%; margin: 0 auto; }
      .sobre-title { font-size: 24px; }
      .sobre-desc { font-size: 14px; }
      .sobre-destaque { font-size: 14px; }

      .metodologia { padding: 48px 20px; }
      .metodologia-body { flex-direction: column; gap: 28px; }
      .metodologia-foto { width: 75%; margin: 0 auto; }

      .cta-bg { background-image: url('fundo_mobile.png'); }

      .rodape { padding: 28px 20px 0; }
      .rodape-inner { grid-template-columns: 1fr; gap: 28px; }
    }
  </style>
</head>
<body>

  <!-- ===== HEADER ===== -->
  <header>
    <div class="logo">
      <img src="logo01.png" alt="SenosAmorim Performance" />
    </div>

    <div class="header-right">
      <nav>
        <a href="#inicio">Início</a>
        <a href="#sobre">Sobre</a>
        <a href="#beneficios">Benefícios</a>
        <a href="#metodologia">Metodologia</a>
      </nav>

      <!-- SUBSTITUA: troque pelo seu número com DDD -->
